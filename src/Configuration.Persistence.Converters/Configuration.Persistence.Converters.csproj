<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64</RuntimeIdentifiers>
    <Description>ValueConverters for use with EF Core, handle responsibly.</Description>
    <!-- EF Core does not mark its assemblies CLS-compliant, so any API exposing its types cannot be either. -->
    <SkipClsCompliant>true</SkipClsCompliant>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Configuration.Persistence\Configuration.Persistence.csproj" />
  </ItemGroup>

</Project>
